# Streamlit secrets template.
#
# Local dev: copy this file to .streamlit/secrets.toml and fill in your key
#            (that file is gitignored). You can also just use a .env file instead.
# Deploy:    paste these values into the "Secrets" box in the Streamlit Community
#            Cloud app settings — do NOT commit the real secrets.toml.

GOOGLE_API_KEY = "your-api-key-here"

# Optional: gate the app behind a password (recommended for public deploys).
# When unset, the app is open to anyone with the URL.
# APP_PASSWORD = "choose-a-strong-password"

# Optional overrides (defaults shown):
# GEMINI_MODEL = "gemini-2.5-flash-lite"
# GEMINI_MAX_RETRIES = "6"

# Optional: Snowflake data layer (see .env.example for details).
# DATA_SOURCE = "snowflake"
# SNOWFLAKE_ACCOUNT = "your-account-identifier"
# SNOWFLAKE_USER = "your-username"
# SNOWFLAKE_PASSWORD = "your-password-or-token"
# SNOWFLAKE_WAREHOUSE = "MEDBILL_WH"
# SNOWFLAKE_DATABASE = "MEDBILL_DB"
# SNOWFLAKE_SCHEMA = "AUDIT"
