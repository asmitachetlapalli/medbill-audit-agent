# Copy this file to .env and fill in your values. Do not commit .env.

# Required for the AI summary / audit agent (Google AI Studio API key).
GOOGLE_API_KEY=your-api-key-here

# Optional. Gemini model used by the agent. Defaults to gemini-2.5-flash-lite.
# Verified working: gemini-2.5-flash-lite, gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash-lite

# Optional. Retries on transient 429 rate limits (exponential backoff). Defaults to 6.
# GEMINI_MAX_RETRIES=6

# Optional. Password-gate the app. When unset, the app is open to anyone with the URL.
# APP_PASSWORD=choose-a-strong-password

# --- Snowflake data layer -------------------------------------------------------------
# Where bills and reference data come from: "local" (CSV + uploaded PDFs, the default)
# or "snowflake" (tables created by sql/01_setup.sql, loaded by scripts/load_data.py).
# DATA_SOURCE=local

# Account identifier, e.g. "abc12345.us-east-1" or "myorg-myaccount" (from Snowsight:
# your name > Account > View account details).
SNOWFLAKE_ACCOUNT=your-account-identifier
# Your LOGIN name (the login_name column of SHOW USERS) — on trial accounts this is often
# your email address, not the short user name.
SNOWFLAKE_USER=your-login-name
# Recommended: key-pair auth (no MFA prompts, no expiry). Path to an unencrypted PKCS#8
# private key whose public key is registered with ALTER USER ... SET RSA_PUBLIC_KEY.
# Keep the key outside the repo. When set, SNOWFLAKE_PASSWORD is ignored.
# SNOWFLAKE_PRIVATE_KEY_FILE=~/.snowflake/medbill_rsa_key.p8
# Otherwise: your password or a programmatic access token.
# SNOWFLAKE_PASSWORD=your-password-or-token
SNOWFLAKE_WAREHOUSE=MEDBILL_WH
SNOWFLAKE_DATABASE=MEDBILL_DB
SNOWFLAKE_SCHEMA=AUDIT
# Optional. Defaults to your user's default role.
# SNOWFLAKE_ROLE=ACCOUNTADMIN
